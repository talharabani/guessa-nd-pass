# ─────────────────────────── Number Rush — server ───────────────────────────
# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Managed PostgreSQL (Neon / Supabase / Render Postgres).
# Leave EMPTY in local dev to run on the in-memory store (accounts reset on restart).
# Required in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/number_rush?sslmode=require

# Signing key for JWTs. Generate with:  openssl rand -base64 48
# Required in production; the server refuses to boot with the dev default.
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API and open sockets.
# Comma-separated. In production this is your Vercel URL. Wildcards are rejected.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
